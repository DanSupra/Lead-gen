# Environment example

# Meta
META_APP_SECRET=
META_VERIFY_TOKEN=change_me
# Page tokens should be stored securely; for local testing you can set PAGE_TOKEN_<page_id>
# PAGE_TOKEN_1234567890=

# Postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Celery/Redis
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/1
